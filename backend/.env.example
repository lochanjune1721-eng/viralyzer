# ---------- Database (Supabase Postgres) ----------
# Runtime: the SESSION pooler on port 5432 (API, worker, LangGraph checkpointer).
# Never the transaction pooler on 6543: no prepared statements, no SET search_path.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Admin: the DIRECT connection, reserved for migrations, pg_dump and
# `python -m viralyzer.db.checkpointer setup`.
SUPABASE_DB_DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
LANGGRAPH_SCHEMA=langgraph
# Dimension of voice / sample / source embeddings (must match the vector(N) columns).
EMBEDDING_DIMENSIONS=1536

# ---------- Tests ----------
# Any Postgres 15+ with pgvector; the suite creates and drops its own databases.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ---------- Monid (research connectors) ----------
MONID_API_KEY=
