# ---------- Core ----------
# Public base URL of this deployment. Required for OAuth callbacks and for
# platforms that fetch the rendered video by URL (Instagram, Ayrshare).
PUBLIC_BASE_URL=http://localhost:3000
# Where the SQLite database and media files live (defaults: ./data and ./storage)
DATA_DIR=./data
STORAGE_DIR=./storage
# Optional explicit ffmpeg/ffprobe binaries (defaults to PATH, then ffmpeg-static)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ---------- Remotion (motion-graphics renderer) ----------
# Layout renders use Remotion templates in ./remotion and need a headless Chrome.
# `npx remotion browser ensure` downloads one; or point at an existing binary:
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
# REMOTION_BUNDLE_DIR=./remotion-bundle   (defaults to DATA_DIR/remotion-bundle)
# REMOTION_DISABLE=1                      (always render with the FFmpeg engine instead)

# ---------- LLM (DeepSeek, OpenAI-compatible) ----------
DEEPSEEK_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ---------- Transcription (word-level timestamps) ----------
# Provider is auto-detected from whichever key is set: openai | groq | deepgram.
# With no key the app falls back to aligning the script to the footage (mock mode).
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
# ElevenLabs Scribe (the transcription layer of the video-use engine; takes priority when set)
ELEVENLABS_API_KEY=
# TRANSCRIBE_PROVIDER=openai

# ---------- Image sourcing for visuals ----------
# Keyless providers (Wikipedia + Openverse) are used by default. Optional:
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---------- Publishing: native platform OAuth apps ----------
# Callback URL for each platform is {PUBLIC_BASE_URL}/api/connections/<platform>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------- Publishing: aggregator (optional, replaces native adapters) ----------
# If set, all platforms publish through Ayrshare with a single API key.
AYRSHARE_API_KEY=
# PUBLISH_PROVIDER=native   # native | ayrshare

# Secret used to sign OAuth state and the session cookie
APP_SECRET=change-me
